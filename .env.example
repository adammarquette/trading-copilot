# Copy to .env (gitignored) for local overrides -- real secrets are NEVER committed.
# See ADR-0012 / engineering §8. The app reads its DB connection string from config.

# --- docker-compose `db` service (local dev only) ---
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=tradingcopilot

# --- app configuration (ASP.NET Core) ---
# Connection string is config: point at the compose db, a local Postgres, or a managed instance.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=tradingcopilot;Username=copilot;Password=copilot

# JWT signing key -- a long random secret (>= 32 bytes); REQUIRED to run the API (R-18 auth). Issuer/Audience/Lifetime default from appsettings.json.
Jwt__SigningKey=

# First-operator bootstrap: invitation-only onboarding needs a first operator to issue the first invite.
# Set both to seed one on startup if none exists (compose defaults these for local dev); leave unset to skip.
Bootstrap__Email=
Bootstrap__Password=

# --- Broker / venue: ProjectX (TopstepX) -- the R-17 v1 adapter ---
# PRACTICE ACCOUNTS ONLY outside production (R-14). TradingModePolicy refuses a live real-money
# account anywhere but production, but that gate is the backstop -- do not point dev or staging at
# a live account in the first place. Obtain credentials from the firm's portal.
# The client also accepts PROJECTX_API_KEY / PROJECTX_API_SECRET, which OVERRIDE these if set --
# use one form or the other, not both.
ProjectX__ApiKey=
ProjectX__ApiSecret=
# Optional -- defaults target TopstepX. Other ProjectX firms run their own branded hosts.
# ProjectX__BaseUrl=https://api.topstepx.com

# API keys (local dev) -- obtain your own; leave unset to disable that integration:
# Cohere__ApiKey=
# Finnhub__ApiKey=
# Tiingo__ApiKey=
