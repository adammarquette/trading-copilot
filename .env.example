# Copy to .env (gitignored) for local overrides -- real secrets are NEVER committed.
# See ADR-0012 / engineering §8. The app reads its DB connection string from config.

# --- docker-compose `db` service (local dev only) ---
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=tradingcopilot

# --- app configuration (ASP.NET Core) ---
# Connection string is config: point at the compose db, a local Postgres, or a managed instance.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=tradingcopilot;Username=copilot;Password=copilot

# JWT signing key -- a long random secret (>= 32 bytes); REQUIRED to run the API (R-18 auth). Issuer/Audience/Lifetime default from appsettings.json.
Jwt__SigningKey=

# Operator bootstrap: one operator per deployment (ADR-0017), seeded at startup — onboarding is sign-in, not sign-up.
# Set both to seed the operator if none exists (compose defaults these for local dev); leave unset to skip.
Bootstrap__Email=
Bootstrap__Password=

# Which Connection.CredentialKey the ProjectX credentials above belong to (one credential set per process,
# ADR-0015). Create your connection with this same key; discovery on any other key is refused with a clear error.
# DataTier: Simulated (practice universe, the fail-safe default) or Live.
ProjectX__CredentialKey=projectx
ProjectX__DataTier=Simulated

# Market-data ingestion (R-1) -- OPT-IN. Leave unset to disable the ingestion host; set a symbol (e.g. MES) to
# subscribe its live quote stream into the event log.
#
# Compose forwards EIGHT watchlist slots, __0 through __7 -- it cannot forward an open-ended indexed list, so
# the slots are enumerated in the app service's environment map. A ninth symbol needs another line added there.
# (Before gh#304 only __0 was forwarded while this file said to add __1, __2: the extra symbols were read for
# interpolation and then silently dropped, and the app subscribed to one instrument without saying so.)
#
# The slots are independent, not positional -- setting only __2 binds correctly and gaps are harmless.
# Ingestion__Symbols__0=MES
# Ingestion__Symbols__1=MNQ
# Ingestion__ReconnectDelaySeconds=5

# Clean-historical bar store (R-1, gh#302) -- the SECOND market-data path, and the SYSTEM OF RECORD. R-1 keeps
# the two apart on purpose: the live stream above is a pipeline; this is the authoritative series journaling and
# replay read (R-9), and the store a full indicator rebuild reprocesses (ADR-0001).
#
# OPT-IN and configured INDEPENDENTLY of Ingestion__Symbols -- you may want history without a live subscription,
# or the reverse. Unset means idle, never "archive everything".
#
# Each pass re-fetches a LOOKBACK window wider than the poll interval. That overlap is deliberate: it is how a
# venue's later revision of a bar lands, and how a missed pass heals itself instead of leaving a permanent hole.
# There is NO retention policy on this table -- expiring the system of record would defeat the point.
# Backfill__Instruments__0=ES
# Backfill__ResolutionMinutes__0=1
# Backfill__PollIntervalSeconds=60
# Backfill__LookbackMinutes=120

# Indicator projections over that bar store (R-1, gh#310, ADR-0001: "indicators are projections... rebuild =
# replay"). ALWAYS ON and deliberately has no symbol list of its own -- it projects whatever the bar store holds,
# so an archived instrument can never end up without its indicators.
#
# ATR is the first one, and it is what lifts StopPlan's long-standing refusal of an ATR-based promotion band
# (gh#311). The period is Wilder's 14 by default because that is what your chart is showing -- a stop distance
# that disagrees with your chart is worse than no ATR at all. A value is only produced once the period is
# satisfied; a partial one would place a stop at the wrong distance while looking entirely ordinary.
#
# BandResolutionMinutes is which bar size an ATR *promotion band* is measured on (gh#311). ADR-0007 names ATR as
# a proximity metric but not the series -- and 2 x ATR on 1-minute bars is a very different stop distance from
# 2 x ATR on 15-minute bars, so it is stated rather than assumed. It MUST be one of Backfill__ResolutionMinutes
# above (the defaults match at 1). If it is not, no value exists, and an ATR-banded stop then does NOT promote:
# the safe direction, but a silent one, so the promotion watcher logs a warning naming this setting.
# Indicators__AtrPeriod=14
# Indicators__BandResolutionMinutes=1
# Indicators__PollIntervalSeconds=60

# Deterministic indicator triggers (R-4, gh#385) -- a scan evaluates each enabled trigger over the indicator
# projections above and fires a mechanical alert on the arming edge; the LLM is never in the loop. Always on,
# since its work is whatever triggers the operator authored. Only the cadence is tunable, and the 60s default
# matches the indicator cadence -- bar-derived indicators change only per bar, so scanning faster just re-reads
# the same values.
# Triggers__PollIntervalSeconds=60

# News relevance resolution (R-2, gh#359) -- a 60s pass materializes matched instruments/topics onto ingested
# news via the deployment's global ticker<->instrument maps + topics (authored via /api/relevance). Always on;
# only the cadence is tunable.
# Relevance__PollIntervalSeconds=60

# News / soft-signal ingestion (R-2, gh#358) -- deduped across sources into the store of record. News is
# deliberately MULTI-source (Finnhub + Tiingo) where price data is single-source; the same story from both
# collapses to one row by its canonical-URL dedup key, and an overlapping re-poll is idempotent.
#
# OPT-IN and off by default -- News__Enabled turns the poller on. The concrete provider adapters (their own
# MarqSpec.Client.* submodules) are follow-ons; until one is registered, an enabled poller finds no source and
# writes nothing. Cadence and lookback default in the app (300 s / 60 min), so leave them unset to accept those.
# News__Enabled=true
# News__PollIntervalSeconds=300
# News__LookbackMinutes=60

# Observability (gh#230/gh#231, ADR-0002) -- the LGTM stack is OPT-IN, behind the `observability` compose
# profile: `docker compose --profile observability up -d`. Leave the endpoint unset and the app simply does not
# export; telemetry is fire-and-forget, so an absent stack never affects trading.
#
# The app's telemetry settings are Telemetry__* (its Options section), documented once further down -- NOT the
# OpenTelemetry SDK's own OTEL_* variables. gh#231 wired OTEL_* here and into compose by mistake, so neither
# reached anything the app reads; gh#325's check found it. To export into the compose stack, set:
#   Telemetry__OtlpEndpoint=http://otel-collector:4318
# Grafana admin login -- LOCAL DEVELOPMENT ONLY. A deployed Grafana takes these from its environment's secret
# store; never commit a real one, never leave a deployed instance on the default.
# GF_SECURITY_ADMIN_USER=admin
# GF_SECURITY_ADMIN_PASSWORD=admin

# Alerting channel (gh#243, ADR-0019) -- Layer 1: the push the app sends ITSELF, because it knows first.
# Routing a P1 through a metrics scrape and a rule evaluation costs tens of seconds, and CL/GC have roughly
# fifteen minutes of margin in total.
#
# Pushover because an on-call-of-one needs a PAGER, not a notification: its Emergency priority is the only one
# that repeats until ACKNOWLEDGED and bypasses Do Not Disturb. Create an application at pushover.net; the user
# key is on your dashboard. One-time ~$5 per platform, your own account (ADR-0015).
#
# Leave unset to run without a channel -- allowed; the app then logs what it WOULD have sent (a Page logs as an
# error) and warns at startup. Both values are secrets: never commit them.
# Pushover__AppToken=your-application-token
# Pushover__UserKey=your-user-key
# How often an unacknowledged page repeats, and when Pushover stops retrying. Defaults 60s / 1800s (ADR-0019).
# Pushover__PageRetrySeconds=60
# Pushover__PageExpireSeconds=1800

# LLM for the agent-review trigger route (gh#402 / gh#423, ADR-0008). The key is what makes the route WAKE A MODEL:
# with it, a fired agent-review trigger calls Anthropic (via AnthropicLlmProvider) to propose a Suggestion or
# suppress; without it, the route still fires and still TELLS you a setup needs review -- it just cannot propose.
# The key is a SECRET (it rides the x-api-key header only, never a log); your own account, your own spend (ADR-0015).
#
# Deliberately NOT in the local `docker compose` allowlist, so a dev stack never makes paid calls (the app ships
# INERT). Set it in your production env (Railway) to activate; to exercise it locally, add Llm__ApiKey to the app
# service's `environment:` map yourself.
# Llm__ApiKey=sk-ant-your-key
# Optional model overrides (non-secret). Defaults: a cheap triage model + a stronger deep one (ADR-0008 tiering).
# Llm__TriageModel=claude-haiku-4-5
# Llm__DeepModel=claude-sonnet-5
# How long one completion may take before the client aborts it (bounds a hung provider on the scan). Default 30s.
# Llm__TimeoutSeconds=30

# Alertmanager's OWN Pushover credentials (gh#245, ADR-0019 Layer 1). Separate variables from Pushover__* above
# on purpose: those configure the APP's direct push (Layer 0, the fast path), these configure the rule engine's
# backstop push. They may hold the same values -- but they are read by different processes, and a stack whose
# alerting silently inherited the app's config would give no way to test one without the other.
#
# Only consumed when the `observability` profile is up:
#   docker compose --profile observability up -d
#
# Alertmanager FAILS TO LOAD if these expand to nothing, so compose defaults them to an obvious placeholder --
# the stack starts, and the runbook's "send a test page" step is what surfaces a missing token. That is
# deliberate: a broken token should not take down the container that reports everything else.
# PUSHOVER_USER_KEY=your-user-key
# PUSHOVER_API_TOKEN=your-application-token
#
# Where Alertmanager's always-firing heartbeat goes. Its ABSENCE is the alarm -- point it at a dead-man's-switch
# check (the same kind gh#244 uses) on infrastructure INDEPENDENT of this stack, or a silent rule engine is
# indistinguishable from a quiet day. Also a CAPABILITY URL: whoever holds it can forge an all-clear.
# Defaults to Alertmanager's own health endpoint, which is a no-op that keeps the route valid but monitors
# nothing.
# ALERTMANAGER_HEARTBEAT_URL=https://hc-ping.com/your-uuid-here

# The dead-man's switch (R-13, gh#244, ADR-0019) -- the ONLY alerting tier that survives this process dying.
# Every other alert assumes something is alive to raise it; if the host dies before an auto-flatten deadline, the
# flatten never fires AND nothing alerts. This inverts that: the app reports to an EXTERNAL monitor, which pages
# when the report FAILS TO ARRIVE. Silence is the alarm.
#
# Leave unset to run unmonitored -- allowed, and the app warns loudly at startup so it is never a silent default.
#
# The monitor MUST run on infrastructure independent of this app. One sharing this host or this Railway project
# is not a dead-man's switch, it is a second thing that dies at the same moment.
#
# These URLs are CAPABILITY URLs: whoever holds one can forge an all-clear on a safety path. Treat them as
# secrets -- never commit them, never paste them into an issue. They are never logged by the app.
#
# Set each instrument's monitor check to expect a ping by its flatten deadline + ~5 min, on weekdays. A market
# whose auto-flatten you deliberately disable will NOT check in -- pause that check, or it will page.
# CheckIn__HeartbeatUrl=https://hc-ping.com/your-liveness-uuid
# CheckIn__HeartbeatIntervalSeconds=60
# CheckIn__PollIntervalSeconds=60
# CheckIn__Instruments__0__Symbol=ES
# CheckIn__Instruments__0__Url=https://hc-ping.com/your-es-uuid
# CheckIn__Instruments__1__Symbol=NQ
# CheckIn__Instruments__1__Url=https://hc-ping.com/your-nq-uuid
# Compose forwards FOUR instrument slots (0-3), matching the four markets with built-in deadlines. A fifth needs
# another pair added to the app service's environment map in docker-compose.yml.

# Auto-flatten (R-13, gh#185) -- ON BY DEFAULT, per market: the scheduler closes open positions at each instrument's
# per-market deadline (equity-index ES/NQ default ~2:30 PM CT pre-MOC; crude CL / gold GC earlier). It CANNOT be
# silently disabled -- these settings only OVERRIDE the built-in defaults, never enable it. Times are 24-hour market
# (Central) HH:mm. Disable a market deliberately with Enabled=false; move a deadline with SessionClose (the default)
# or DeadlineOverride. Configure further markets on Flatten__Instruments__1__..., __2__..., __3__ (see the cap below).
#
# Forwarded by docker compose (gh#236). Leaving a key unset here is the normal case: it arrives ABSENT rather
# than empty, so the app's built-in default stands -- auto-flatten stays armed either way. The per-instrument
# slots are CAPPED AT FOUR (Instruments__0__ .. __3__), which covers the four markets that carry built-in
# deadlines (ES, NQ, CL, GC); a fifth market needs its keys added to docker-compose.yml. Slots are independent,
# so gaps are fine -- just keep one instrument's fields on the same index.
#
# VERIFY IT TOOK (gh#255): the app logs every armed market at startup with its source --
#   "Auto-flatten armed for ES at 14:15 CT (...) -- ConfiguredOverride."   <- your setting reached the app
#   "Auto-flatten armed for ES at 14:30 CT (...) -- BuiltInDefault."       <- it did NOT; the default is running
# A disabled market logs at WARN. Read that, rather than assuming a clean start means the override applied.
# Flatten__PollIntervalSeconds=15
# Flatten__MaxFlattenAttempts=3
# Flatten__Instruments__0__Symbol=ES
# Flatten__Instruments__0__SessionClose=14:30
# Flatten__Instruments__0__Enabled=true
#
# Redundant watchdog (R-13, gh#187) -- the INDEPENDENT second tier: a separate loop that backstops the primary's
# failures so the flatten still fires when the primary is degraded. Always on. WatchdogGraceMinutes is how long
# past a deadline it waits before stepping in (deferring to the primary first); WatchdogPollIntervalSeconds is its
# own cadence, independent of the primary's PollIntervalSeconds above. Forwarded by compose (gh#236).
# Flatten__WatchdogGraceMinutes=2
# Flatten__WatchdogPollIntervalSeconds=20

# Execution sanity caps (R-16, gh#11) -- the LAST-LINE fat-finger bounds, checked below the operator's declared
# per-account risk rules and independent of them: whatever a RiskProfile allows, these still bind. Defaults are
# deliberately conservative; raise them per environment only with a reason. StopPromotionTicks is how close price
# must come to a hidden working stop before it is promoted to a native order (ADR-0007) -- tick-based on purpose,
# never a percentage of raw price. Forwarded by docker compose (gh#236) -- unset means ABSENT, so the app's
# conservative defaults stand unless you deliberately set one.
# Execution__MaxContractsPerOrder=5
# Execution__MaxNotional=250000
# Execution__FatFingerBandTicks=200
# Execution__StopPromotionTicks=8

# Password recovery (R-18): forgot the password? Set Bootstrap__Password to the NEW password, set this to true,
# restart once, sign in, then REMOVE the flag. Resets the EXISTING operator in place (same user id, workspace
# intact). Deliberately an explicit opt-in: without it a stale password above can never overwrite the stored one.
Bootstrap__ResetPassword=

# --- Broker / venue: ProjectX (TopstepX) -- the R-17 v1 adapter ---
# PRACTICE ACCOUNTS ONLY outside production (R-14). TradingModePolicy is WIRED at the composition
# root (gh#9): the host environment maps onto the R-14 ladder (unknown names fail closed to
# Development = practice-only), and every account the API serves carries `tradeableHere` -- a live
# account reads as untradeable everywhere but production, an undeclared one everywhere. This gate
# now BLOCKS, it does not merely mark: the execution endpoints landed (gh#11), and the enforcing
# send path refuses a disallowed mode x environment pair as RefusedByMode -- guard 1 of 5, before
# the ticket is even sized. Non-prod is practice-only by construction. Obtain credentials from the
# firm's portal.
# MIND THE MAPPING -- the client's option names do not say what the gateway actually wants:
#   ProjectX__ApiKey     ->  your TopstepX USERNAME   (sent as "username")
#   ProjectX__ApiSecret  ->  your API KEY             (sent as "apikey")
# /api/Auth/loginKey is "log in as the specified user using the specified API key", so an API key
# in BOTH fields authenticates as a user who doesn't exist and fails with a bare
# "Authentication failed: Unknown error" -- a 200 response carrying success=false, no reason given.
# The client also honours PROJECTX_API_KEY / PROJECTX_API_SECRET, which override the settings below.
# Do NOT use that form with docker compose: compose forwards only the keys named in the app service's
# `environment` map, and those two are not among them -- they would be read from .env for
# interpolation and then silently dropped. Under compose, use the ProjectX__ form.
ProjectX__ApiKey=
ProjectX__ApiSecret=
# Other ProjectX firms run their own branded hosts. Leave unset for TopstepX -- compose supplies that
# default, so an unset value never reaches the client as an empty string.
# ProjectX__BaseUrl=https://api.topstepx.com

# API keys (local dev) -- obtain your own; leave unset to disable that integration:
# Cohere__ApiKey  -- the embedding provider (gh#403). UNSET keeps the keyless default: semantic retrieval is
#   simply OFF (dense embeddings unavailable, hybrid search degrades to sparse), announced once at startup, and
#   nothing on the trading path depends on it. SET it and CohereEmbeddingProvider takes over -- still degrading
#   to sparse rather than throwing on a rate limit or outage. The model and the cost rate are code defaults
#   (CohereOptions), not env knobs, so only the key lives here.
# Cohere__ApiKey=
# Finnhub__ApiKey=
# Tiingo__ApiKey=

# Reviewer GitHub App (optional) -- uncomment to let agents render formal PR review verdicts as a
# distinct identity, since GitHub blocks approving / requesting changes on your own PR (gh#141;
# one-time setup in the deployment runbook). The App ID and installation ID are not secret. The
# private key is referenced as a FILE PATH, never inlined -- a multi-line PEM does not survive a
# line-based .env (cramming it fuses the BEGIN header onto the base64 and openssl then rejects it).
# REVIEWER_APP_ID=
# REVIEWER_APP_INSTALLATION_ID=
# REVIEWER_APP_PRIVATE_KEY_FILE=/absolute/path/to/reviewer.pem

# Observability (gh#230, ADR-0002) -- OPT-IN. Unset means the OpenTelemetry SDK is still wired and instrumentation
# still runs, but nothing is exported and the app starts and trades normally: instrumentation must never be able
# to break trading (engineering §9). Point this at the OTLP collector once the LGTM stack lands (gh#231).
# Telemetry__OtlpEndpoint=http://localhost:4317
# Telemetry__ServiceName=trading-copilot-api
