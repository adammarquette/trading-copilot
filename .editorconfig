# EditorConfig — Trading Co-Pilot
# Encodes the C# coding conventions in engineering §4 and
# documentation/wiki/pages/dotnet-coding-conventions.md.
# Baseline: Microsoft's C# conventions (adopted from dotnet/runtime + Roslyn).
# One project deviation — queries use fluent / method syntax, never LINQ
# query-comprehension. See the note at the bottom of the [*.cs] section.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Markdown: trailing double-spaces are meaningful (hard line breaks).
[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{json,yml,yaml,csproj,props,targets,slnx,editorconfig}]
indent_size = 2

[*.cs]
indent_size = 4

# --- Implicit typing: var only when the type is obvious ---
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# --- Namespaces & usings ---
csharp_style_namespace_declarations = file_scoped:error
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true

# --- Braces & layout: Allman, always braces ---
csharp_prefer_braces = true:warning
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# --- Expression-level preferences (Microsoft baseline) ---
dotnet_style_prefer_collection_expression = true:suggestion
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion

# --- Language keywords over BCL runtime types (string, int, ...) ---
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

# --- No this. qualification (private fields use the _ prefix instead) ---
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# =====================================================================
# Naming conventions
# =====================================================================
# Interfaces: IPascalCase
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_start_with_i.style = i_pascal_style
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.i_pascal_style.capitalization = pascal_case
dotnet_naming_style.i_pascal_style.required_prefix = I

# Types & non-field members: PascalCase
dotnet_naming_rule.types_and_members_pascal.severity = warning
dotnet_naming_rule.types_and_members_pascal.symbols = type_and_member_symbols
dotnet_naming_rule.types_and_members_pascal.style = pascal_style
dotnet_naming_symbols.type_and_member_symbols.applicable_kinds = class, struct, enum, interface, property, method, event, delegate, namespace
dotnet_naming_style.pascal_style.capitalization = pascal_case

# Constants: PascalCase
dotnet_naming_rule.constants_pascal.severity = warning
dotnet_naming_rule.constants_pascal.symbols = constant_symbols
dotnet_naming_rule.constants_pascal.style = pascal_style
dotnet_naming_symbols.constant_symbols.applicable_kinds = field
dotnet_naming_symbols.constant_symbols.required_modifiers = const

# Private instance fields: _camelCase
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbols
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_style
dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_style.capitalization = camel_case
dotnet_naming_style.underscore_camel_style.required_prefix = _

# Parameters & locals: camelCase
dotnet_naming_rule.parameters_camel.severity = suggestion
dotnet_naming_rule.parameters_camel.symbols = parameter_symbols
dotnet_naming_rule.parameters_camel.style = camel_style
dotnet_naming_symbols.parameter_symbols.applicable_kinds = parameter, local
dotnet_naming_style.camel_style.capitalization = camel_case

# =====================================================================
# PROJECT DEVIATION — queries use fluent / method syntax ONLY
# =====================================================================
# Do NOT write LINQ query-comprehension:   from o in orders where o.IsOpen select o.Id
# Do write fluent / method chains:         orders.Where(o => o.IsOpen).Select(o => o.Id)
# Applies everywhere queries are defined, EF Core included.
#
# There is NO first-party Roslyn analyzer that bans query-comprehension syntax, so this
# rule is enforced by CODE REVIEW (and, later, a candidate custom analyzer / architecture
# test). Documented in engineering §4 and wiki/pages/dotnet-coding-conventions.md.

# EF Core migrations are generated code — exempt from style / doc / format enforcement.
[**/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.CS1591.severity = none
